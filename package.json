{
  "name": "foodflow-demo",
  "private": false,
  "version": "1.0.0",
  "description": "FoodFlow Demo — Open-Source White-Label Food Ordering & WhatsApp Checkout Starter Kit (Zero-Backend)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/soycheppi/foodflow-demo.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:assets": "node scripts/build-brand-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y",
    "check:circular": "madge --circular src",
    "knip": "knip",
    "audit": "npm run typecheck && npm run lint && npm run test && npm run check:circular && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/query-sync-storage-persister": "^5.90.22",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "browser-image-compression": "^2.0.2",
    "lenis": "^1.3.17",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.2.0",
    "sonner": "^2.0.8",
    "web-vitals": "^6.2.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.21.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "knip": "^6.35.1",
    "madge": "^8.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.1"
  }
}
