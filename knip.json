{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": [
    "src/**/*.{ts,tsx}!"
  ],
  "ignore": [
    "src/adapters/**",
    "src/config/**",
    "src/modules/auth/hooks/**",
    "src/modules/catalog/hooks/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "tailwindcss"
  ],
  "ignoreBinaries": [
    "firebase"
  ]
}
