# Firebase Production Configuration (Optional)
# If left empty, FoodFlow automatically runs in Local Mock / Demo Mode out-of-the-box.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# CDN URL for static storage (Optional)
VITE_CDN_URL=

# App Check / Security (Optional)
VITE_RECAPTCHA_SITE_KEY=
VITE_APP_CHECK_DEBUG_TOKEN=

# Local Firebase Emulator (Set to true to test Firebase 100% offline with zero account)
# VITE_USE_FIREBASE_EMULATORS=true

